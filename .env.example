# Django
DJANGO_SECRET_KEY=CAMBIAR-POR-UNA-CLAVE-LARGA-Y-UNICA
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=eventos.tudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://eventos.tudominio.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_LOG_LEVEL=INFO

# Base de datos de producción
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=dirtec_event_studio
POSTGRES_USER=dirtec_app
POSTGRES_PASSWORD=CAMBIAR-POR-UNA-CONTRASENA-UNICA
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# SaaS: dejar False en el primer despliegue hasta verificar suscripciones.
SAAS_REQUIRE_SUBSCRIPTION=False

# Correo: durante primera salida puede seguir en consola. Configurar SMTP después.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
